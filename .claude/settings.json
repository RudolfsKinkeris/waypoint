{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-response-shape.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-severity-enum.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/vocabulary-check.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
