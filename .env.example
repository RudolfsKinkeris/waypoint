# Copy this file to .env in the repo root for local development
# (server/package.json's dev/start scripts load it automatically via
# --env-file-if-exists). In production (e.g. Render), set these as real
# environment variables in the host's dashboard instead of a .env file.

# Port the Express server listens on. Render sets this automatically —
# only needed for local development, and only if you want something other
# than the default of 3001.
PORT=3001

# Public base URL of this deployment, used to build the "view this run"
# link included in Discord failure-alert messages. Defaults to
# http://localhost:5173 if unset, which is fine for local dev.
APP_BASE_URL=http://localhost:5173

# Optional. If set, a Discord webhook message is posted whenever a test
# run result is marked "failed", or when a test case newly becomes flaky
# (see /flaky-tests). Leave unset to disable both alerts entirely — this
# is not required for the app to run.
DISCORD_WEBHOOK_URL=
